---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entrees = await getCollection("journal");
  return entrees.map((e) => ({ params: { slug: e.slug }, props: { entree: e } }));
}

const { entree } = Astro.props;
const { Content } = await entree.render();
---

<Base titre={entree.data.titre}>
  <p class="mb-4"><a href="/journal/" class="text-sm text-laiton hover:underline">← Le journal de recherche</a></p>
  <p class="donnee mb-1 text-xs text-pierre/50">{entree.data.date}</p>
  <h1 class="mb-6 text-2xl font-semibold tracking-tight">{entree.data.titre}</h1>
  <div class="prose-journal max-w-2xl text-pierre/85">
    <Content />
  </div>
</Base>

<style is:global>
  .prose-journal h2 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: #ebe6dc;
  }
  .prose-journal p,
  .prose-journal ul {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .prose-journal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
</style>
