---
import Base from "../layouts/Base.astro";
import Khatem from "../components/Khatem.astro";
import { compteurs } from "../lib/data";
import { QUESTIONS_OUVERTES, LIBELLES_STATUT_QUESTION } from "../lib/questions-ouvertes";

const { total, prouvees } = compteurs();
const questionsAffichees = QUESTIONS_OUVERTES.slice(0, 3);
---

<Base titre="Accueil">
  <section class="fond-zellige -mx-4 mb-20 border-b border-laiton/10 px-4 py-16 sm:-mx-6 sm:px-6">
    <div class="mx-auto max-w-xl text-center">
      <Khatem taille={36} class="mx-auto mb-6 text-laiton" titre="Khatem" />
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Arrouasse (Tlemcen) &middot; Amsellem–Benchetrit (Alger)
      </h1>
      <p class="mt-5 text-pierre/75">
        Une ligne paternelle de familles juives séfarades pieds-noirs d'Algérie, arrivées en
        France en 1962. Ce site documente ce qui est prouvé, ce qui est transmis, ce qui est
        supposé — et ce qu'on ignore encore.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a href="/arbre/" class="lien-discret">Voir l'arbre interactif →</a>
        <a href="/questions-ouvertes/" class="lien-discret">Les questions ouvertes →</a>
      </div>
    </div>
  </section>

  <section class="mb-20 flex flex-col gap-10 sm:flex-row sm:divide-x sm:divide-pierre/10">
    <div class="sm:w-1/3 sm:pr-10">
      <p class="donnee text-4xl text-pierre">{total}</p>
      <p class="mt-2 text-pierre/60">personnes dans l'arbre</p>
    </div>
    <div class="sm:flex-1 sm:pl-10">
      <p class="donnee text-4xl text-vert">{prouvees}</p>
      <p class="mt-2 text-pierre/60">
        prouvées par acte, presse ou registre — les autres reposent sur un témoignage, une
        hypothèse, ou restent inconnues.
      </p>
    </div>
  </section>

  <section>
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-xl font-semibold tracking-tight">Questions ouvertes du moment</h2>
      <a href="/questions-ouvertes/" class="lien-discret">Tout voir →</a>
    </div>
    <ul class="divide-y divide-pierre/10">
      {questionsAffichees.map((q) => (
        <li class="py-6 first:pt-0">
          <span class="donnee text-[0.7rem] uppercase text-laiton">
            {LIBELLES_STATUT_QUESTION[q.statut]}
          </span>
          <p class="mt-1.5 text-pierre/85">{q.question}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
