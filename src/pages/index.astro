---
import Base from "../layouts/Base.astro";
import Khatem from "../components/Khatem.astro";
import { compteurs, toutesLesPersonnes } from "../lib/data";
import { QUESTIONS_OUVERTES, LIBELLES_STATUT_QUESTION } from "../lib/questions-ouvertes";

const { total, prouvees } = compteurs();
const personnes = toutesLesPersonnes();
const questionsAffichees = QUESTIONS_OUVERTES.slice(0, 3);

const EXPLORER = [
  { titre: "Les branches", description: "Arrouasse, Amsellem, Benchetrit : histoire, géographie, métiers.", href: "/branches/arrouasse/" },
  { titre: "Chronologie", description: "Du décret Crémieux (1870) au départ de 1962.", href: "/chronologie/" },
  { titre: "Le registre des sources", description: `${personnes.length} personnes, chacune avec ses sources citées.`, href: "/sources/" },
];
---

<Base titre="Accueil">
  <section class="fond-zellige -mx-4 mb-16 border-b border-laiton/10 px-4 py-16 sm:-mx-6 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <Khatem taille={36} class="mx-auto mb-5 text-laiton" titre="Khatem" />
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Arrouasse (Tlemcen) &middot; Amsellem–Benchetrit (Alger)
      </h1>
      <p class="mt-4 text-pierre/75">
        Une ligne paternelle de familles juives séfarades pieds-noirs d'Algérie, arrivées en
        France en 1962. Ce site documente ce qui est prouvé, ce qui est transmis, ce qui est
        supposé — et ce qu'on ignore encore.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        <a href="/arbre/" class="lien-discret">Voir l'arbre interactif →</a>
        <a href="/questions-ouvertes/" class="lien-discret">Les questions ouvertes →</a>
      </div>
    </div>
  </section>

  <section class="mb-16 flex flex-col gap-8 sm:flex-row sm:divide-x sm:divide-pierre/10">
    <div class="sm:w-1/3 sm:pr-8">
      <p class="donnee text-4xl text-pierre">{total}</p>
      <p class="mt-1 text-sm text-pierre/60">personnes dans l'arbre</p>
    </div>
    <div class="sm:flex-1 sm:pl-8">
      <p class="donnee text-4xl text-vert">{prouvees}</p>
      <p class="mt-1 text-sm text-pierre/60">
        dont {prouvees} prouvées par acte, presse ou registre — les autres reposent sur un
        témoignage, une hypothèse, ou restent inconnues. Aucun chiffre n'est arrondi à
        l'optimisme.
      </p>
    </div>
  </section>

  <section class="mb-16">
    <div class="mb-2 flex items-center justify-between">
      <h2 class="text-xl font-semibold tracking-tight">Questions ouvertes du moment</h2>
      <a href="/questions-ouvertes/" class="text-sm lien-discret">Toutes les questions →</a>
    </div>
    <ul class="divide-y divide-pierre/10">
      {questionsAffichees.map((q) => (
        <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
          <span class="donnee shrink-0 text-[0.7rem] uppercase text-laiton sm:w-24">
            {LIBELLES_STATUT_QUESTION[q.statut]}
          </span>
          <p class="text-sm text-pierre/85">{q.question}</p>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="mb-2 text-xl font-semibold tracking-tight">Explorer</h2>
    <ul class="divide-y divide-pierre/10">
      {EXPLORER.map((item) => (
        <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between">
          <div>
            <h3 class="font-medium text-pierre">{item.titre}</h3>
            <p class="text-sm text-pierre/60">{item.description}</p>
          </div>
          <a href={item.href} class="shrink-0 text-sm lien-discret">Découvrir →</a>
        </li>
      ))}
    </ul>
  </section>
</Base>
