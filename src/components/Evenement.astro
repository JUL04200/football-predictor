---
import type { Evenement } from "../lib/schema";
import StatutBadge from "./StatutBadge.astro";
import SourcesListe from "./SourcesListe.astro";
import { getLieu } from "../lib/data";

interface Props {
  evenement: Evenement;
  libelle: string;
}

const { evenement, libelle } = Astro.props;
const lieu = getLieu(evenement.lieuId);
---

<div class="carte-fiche">
  <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <h3 class="text-sm uppercase tracking-wide text-pierre/70">{libelle}</h3>
    <StatutBadge statut={evenement.statut} />
  </div>
  <p class="donnee text-lg text-pierre">
    {evenement.date ?? evenement.dateTexte ?? "date inconnue"}
    {lieu && <span class="text-pierre/60"> — {lieu.nom}</span>}
  </p>
  {evenement.notes && <p class="mt-2 text-sm text-pierre/70">{evenement.notes}</p>}
  <div class="mt-3">
    <SourcesListe sourceIds={evenement.sourceIds} />
  </div>
</div>
