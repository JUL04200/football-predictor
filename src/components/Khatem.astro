---
interface Props {
  class?: string;
  taille?: number;
  titre?: string;
}

const { class: className, taille = 24, titre } = Astro.props;
---

<svg
  width={taille}
  height={taille}
  viewBox="0 0 100 100"
  class:list={["shrink-0", className]}
  role={titre ? "img" : "presentation"}
  aria-hidden={titre ? undefined : "true"}
>
  {titre && <title>{titre}</title>}
  <path
    fill="none"
    stroke="currentColor"
    stroke-width="4"
    stroke-linejoin="round"
    d="M50 4 L61 32 L92 26 L69 48 L92 74 L61 68 L50 96 L39 68 L8 74 L31 48 L8 26 L39 32 Z"
  />
</svg>
