---
import type { Statut } from "../lib/schema";

interface Props {
  statut: Statut;
  class?: string;
}

const { statut, class: className } = Astro.props;

const LIBELLES: Record<Statut, string> = {
  prouve: "Prouvé",
  temoignage: "Témoignage",
  hypothese: "Hypothèse",
  inconnu: "Inconnu",
};

const STYLES: Record<Statut, string> = {
  prouve: "border-vert text-vert bg-vert/10",
  temoignage: "border-laiton text-laiton bg-laiton/10",
  hypothese: "border-pierre/50 text-pierre/80 bg-pierre/5 border-dashed",
  inconnu: "border-pierre/25 text-pierre/40 bg-transparent border-dotted",
};

const SYMBOLES: Record<Statut, string> = {
  prouve: "●",
  temoignage: "◐",
  hypothese: "◇",
  inconnu: "○",
};
---

<span
  class:list={[
    "donnee inline-flex items-center gap-1 rounded-sm border px-1.5 py-0.5 text-[0.7rem] uppercase leading-none",
    STYLES[statut],
    className,
  ]}
  title={`Statut : ${LIBELLES[statut]}`}
>
  <span aria-hidden="true">{SYMBOLES[statut]}</span>
  {LIBELLES[statut]}
</span>
