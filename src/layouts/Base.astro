---
import Khatem from "../components/Khatem.astro";
import "../styles/global.css";

interface Props {
  titre: string;
  description?: string;
}

const { titre, description = "Généalogie de la ligne paternelle Arrouasse (Tlemcen) et Amsellem–Benchetrit (Alger), juifs séfarades pieds-noirs d'Algérie." } =
  Astro.props;

const LIENS_PRINCIPAUX = [
  { href: "/", label: "Accueil" },
  { href: "/arbre/", label: "Arbre" },
  { href: "/branches/arrouasse/", label: "Branches" },
  { href: "/chronologie/", label: "Chronologie" },
  { href: "/carte/", label: "Carte" },
  { href: "/sources/", label: "Sources" },
];

const LIENS_SECONDAIRES = [
  { href: "/journal/", label: "Journal de recherche" },
  { href: "/questions-ouvertes/", label: "Questions ouvertes" },
  { href: "/faq/", label: "FAQ" },
  { href: "/contribuer/", label: "Contribuer" },
  { href: "/perimetre/", label: "Le périmètre de ce site" },
];

const chemin = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titre} — Arrouasse · Amsellem</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-laiton focus:px-3 focus:py-2 focus:text-nuit"
    >
      Aller au contenu
    </a>

    <header class="sticky top-0 z-40 border-b border-pierre/10 bg-nuit/95 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
        <a href="/" class="flex items-center gap-2 text-pierre no-underline">
          <Khatem taille={22} class="text-laiton" titre="Khatem, étoile à huit branches" />
          <span class="text-base font-semibold tracking-tight">Arrouasse · Amsellem</span>
        </a>

        <nav aria-label="Navigation principale" class="hidden md:block">
          <ul class="flex gap-x-6 text-sm">
            {LIENS_PRINCIPAUX.map((lien) => (
              <li>
                <a
                  href={lien.href}
                  aria-current={chemin === lien.href ? "page" : undefined}
                  class:list={[
                    "no-underline hover:text-laiton",
                    chemin === lien.href ? "text-laiton" : "text-pierre/70",
                  ]}
                >
                  {lien.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <button
          type="button"
          id="bouton-menu"
          class="no-print flex items-center gap-1.5 border border-pierre/15 px-2.5 py-1.5 text-sm text-pierre/80 hover:border-laiton hover:text-laiton md:hidden"
          aria-expanded="false"
          aria-controls="menu-mobile"
        >
          Menu
        </button>
      </div>

      <nav id="menu-mobile" aria-label="Navigation" class="hidden border-t border-pierre/10 px-4 py-3 md:hidden">
        <ul class="flex flex-col gap-2 text-sm">
          {[...LIENS_PRINCIPAUX, ...LIENS_SECONDAIRES].map((lien) => (
            <li>
              <a
                href={lien.href}
                aria-current={chemin === lien.href ? "page" : undefined}
                class:list={["no-underline hover:text-laiton", chemin === lien.href ? "text-laiton" : "text-pierre/75"]}
              >
                {lien.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="contenu" class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <slot />
    </main>

    <footer class="no-print mt-16 border-t border-pierre/10 py-10 text-sm text-pierre/50">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <nav aria-label="Liens secondaires" class="mb-6 flex flex-wrap gap-x-5 gap-y-2">
          {LIENS_SECONDAIRES.map((lien) => (
            <a href={lien.href} class="text-pierre/60 hover:text-laiton">{lien.label}</a>
          ))}
        </nav>
        <p class="max-w-2xl">
          Site de généalogie familiale — ligne paternelle Arrouasse (Tlemcen) et Amsellem–Benchetrit
          (Alger). La branche maternelle Dukan est hors périmètre de ce site.
        </p>
      </div>
    </footer>

    <script>
      const bouton = document.getElementById("bouton-menu");
      const menu = document.getElementById("menu-mobile");
      bouton?.addEventListener("click", () => {
        const ouvert = menu?.classList.toggle("hidden") === false;
        bouton.setAttribute("aria-expanded", String(ouvert));
      });
    </script>
  </body>
</html>
